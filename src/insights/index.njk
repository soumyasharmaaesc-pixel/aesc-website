---
permalink: "/insights/index.html"
layout: layouts/base.njk
title: "Insights — AESC"
description: "Reports, blogs, and thought leadership from AESC."
canonicalUrl: "https://www.aesc.co.in/insights/"
ogType: "website"
bodyClass: "insights-page"
---

<section class="ins-vhero">
  <video class="ins-vid" autoplay muted loop playsinline poster="/assets/images/about-hero.png">
    <source src="/assets/videos/hero-loop.mp4" type="video/mp4">
  </video>
  <span class="ins-eyebrow">Reports &middot; Blogs &middot; Thought leadership</span>
  <div class="ins-cut"><span>Insights</span></div>
  <p class="ins-sub">Perspectives on leadership, talent and the forces reshaping how organisations grow.</p>
</section>

<section class="athena-section insights-page-section">
  <div class="container">
    <div class="insights-filter-btn-div">
      <a href="javascript:void(0);" class="filter-btn active" data-id="all">All</a>
      <a href="javascript:void(0);" class="filter-btn" data-id="insight-3">Reports/Blogs</a>
    </div>
    <div class="row blg">
      {% for post in blogPosts %}
        <div class="insights-div active" data-class="insight-3">
          <a href="{{ post.url }}" style="text-decoration:none;">
            <div class="insight-grid">
              <div class="insight-bg" style="background-image: url('{{ post.heroImage | imageUrl({ w: 800 }) }}')"></div>
              <div class="insight-content">
                <div class="type-text">{% if post.category %}{{ post.category.title }}{% else %}Insights{% endif %}</div>
                <div class="insight-head">{{ post.title }}</div>
              </div>
            </div>
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.filter-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      var id = btn.getAttribute('data-id');
      document.querySelectorAll('.insights-div').forEach(function(el) {
        el.style.display = (id === 'all' || el.getAttribute('data-class') === id) ? '' : 'none';
      });
    });
  });
</script>
