---
permalink: "/blogs.html"
layout: layouts/base.njk
title: "Leadership & Hiring Blog | Athena Executive Search"
description: "Practical articles from Athena's search partners on executive hiring, leadership assessment, succession and building senior teams."
canonicalUrl: "https://www.aesc.co.in/blogs.html"
ogType: "website"
bodyClass: "insights-page"
---
{% set posts = blogPosts.concat(samplePosts) %}

<section class="res-hero">
  <div class="res-wrap">
    <span class="eyebrow">Resources</span>
    <h1>Blogs</h1>
    <div class="res-rule"></div>
    <p>Practical notes from our partners on hiring, assessing and keeping senior leaders.</p>
  </div>
</section>

<section class="athena-section res-sec">
  <div class="res-wrap">
    {% set featured = posts[0] %}
    <div class="res-top">
      <a class="res-feat" href="{{ featured.url }}">
        <div class="res-feat-img">
          <img src="{% if featured.heroUrl %}{{ featured.heroUrl }}{% else %}{{ featured.heroImage | imageUrl({ w: 1100 }) }}{% endif %}" alt="{{ featured.title }}" loading="eager">
        </div>
        <div class="res-feat-ov">
          <span class="res-chip"><i></i>{{ featured.category.title if featured.category else "Insights" }}</span>
          <h2>{{ featured.title }}</h2>
          <span class="res-meta">{{ featured.publishedAt | date }} <b>&middot;</b> {{ featured.readTime or 6 }} min read</span>
        </div>
      </a>

      <aside class="res-latest">
        <h3 class="res-latest-h">Latest post</h3>
        <ul>
          {% for post in posts.slice(1, 5) %}
          <li>
            <a href="{{ post.url }}">
              <span class="res-thumb"><img src="{% if post.heroUrl %}{{ post.heroUrl }}{% else %}{{ post.heroImage | imageUrl({ w: 200 }) }}{% endif %}" alt="" loading="lazy"></span>
              <span class="res-lt">
                <span class="res-lt-title">{{ post.title }}</span>
                <span class="res-meta">{{ post.publishedAt | date }} <b>&middot;</b> {{ post.readTime or 6 }} min read</span>
              </span>
            </a>
          </li>
          {% endfor %}
        </ul>
      </aside>
    </div>

    <div class="res-row-head">
      <h2>All articles</h2>
      <div class="res-arrows"><button class="res-arw" data-dir="-1" aria-label="Previous">&#8592;</button><button class="res-arw" data-dir="1" aria-label="Next">&#8594;</button></div>
    </div>
    <div class="res-grid" id="resGrid">
      {% for post in posts.slice(1) %}
      <a class="res-card" href="{{ post.url }}" data-i="{{ loop.index0 }}">
        <span class="res-card-img"><img src="{% if post.heroUrl %}{{ post.heroUrl }}{% else %}{{ post.heroImage | imageUrl({ w: 700 }) }}{% endif %}" alt="" loading="lazy"></span>
        <span class="res-card-body">
          <span class="res-chip"><i></i>{{ post.category.title if post.category else "Insights" }}</span>
          <span class="res-card-t">{{ post.title }}</span>
          {% if post.excerpt %}<span class="res-card-x">{{ post.excerpt }}</span>{% endif %}
          <span class="res-meta">{{ post.publishedAt | date }} <b>&middot;</b> {{ post.readTime or 6 }} min read</span>
        </span>
      </a>
      {% endfor %}
    </div>

    <div class="res-pager">
      <button class="res-pg-arw" data-dir="-1" aria-label="Previous page">&#8592;</button>
      <div class="res-pg-nums" id="resPages"></div>
      <button class="res-pg-arw" data-dir="1" aria-label="Next page">&#8594;</button>
    </div>
  </div>
</section>

<script>
(function(){
  var grid=document.getElementById('resGrid'); if(!grid) return;
  var cards=[].slice.call(grid.querySelectorAll('.res-card'));
  var per=3, page=0, pages=Math.ceil(cards.length/per);
  var nums=document.getElementById('resPages');
  function render(){
    cards.forEach(function(c,i){ c.style.display=(i>=page*per && i<(page+1)*per)?'':'none'; });
    nums.innerHTML='';
    for(var p=0;p<pages;p++){(function(p){
      var b=document.createElement('button');
      b.className='res-pg'+(p===page?' on':''); b.textContent=p+1;
      b.addEventListener('click',function(){page=p;render();});
      nums.appendChild(b);})(p);}
  }
  document.querySelectorAll('.res-arw,.res-pg-arw').forEach(function(b){
    b.addEventListener('click',function(){
      var d=parseInt(b.getAttribute('data-dir'),10);
      page=Math.min(pages-1,Math.max(0,page+d)); render();
    });
  });
  render();
})();
</script>
